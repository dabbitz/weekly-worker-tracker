# Copy this file to .env and fill in your own values.
# Never commit the real .env file or real credentials.

# ---------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------
BOT_TOKEN=your-telegram-bot-token

# ---------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------
# PostgreSQL (Neon)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------
# Telegram administrator (bot approval flow - NOT a dashboard login)
# ---------------------------------------------------------------
ADMIN_TELEGRAM_ID=123456789

# ---------------------------------------------------------------
# Admin dashboard (backend-only; never expose these via VITE_*)
# ---------------------------------------------------------------
ADMIN_USERNAME=admin
# Generate with: python scripts/hash_admin_password.py
ADMIN_PASSWORD_HASH=replace-with-an-argon2-hash
# At least 32 random characters
AUTH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Optional extra allowed CORS origin, e.g. https://your-dashboard.example.com
# FRONTEND_ORIGIN=https://your-dashboard.example.com

# ---------------------------------------------------------------
# Frontend (public build-time value only - no secrets)
# ---------------------------------------------------------------
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
